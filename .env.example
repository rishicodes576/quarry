QUARRY_ENV=development
QUARRY_DATABASE_URL=postgresql+psycopg://quarry_runtime:replace-me@postgres:5432/quarry
QUARRY_QDRANT_URL=http://qdrant:6333
QUARRY_SEARXNG_URL=http://searxng:8080
QUARRY_EMBEDDING_MODE=onnx
QUARRY_MODEL_CACHE=/models
QUARRY_DATA_DIR=/data
QUARRY_DEMO_SEED=true
QUARRY_COOKIE_SECURE=false
QUARRY_GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=
QUARRY_GROQ_MODEL=openai/gpt-oss-120b
# Disabled by default. The builder never enables or calls paid providers.
QUARRY_ALLOW_PAID_PROVIDERS=false
OPENAI_API_KEY=
QUARRY_OPENAI_MODEL=gpt-4.1-mini
QUARRY_SESSION_SECRET=replace-with-32-random-bytes
QUARRY_PROXY_SECRET=replace-with-a-separate-random-secret
QUARRY_APP_ORIGIN=http://localhost:3000
QUARRY_SIGNUP_MODE=public
# Local email capture only. Never delivers to the Internet. See http://localhost:8025.
QUARRY_SMTP_HOST=mailpit
QUARRY_SMTP_PORT=1025
QUARRY_SMTP_STARTTLS=false
QUARRY_SMTP_USER=
QUARRY_SMTP_PASSWORD=
QUARRY_MAIL_FROM=accounts@quarry.local
QUARRY_MAX_WORKSPACE_CONVERSATIONS=1000
QUARRY_MAX_WORKSPACE_DOCUMENTS=1000
QUARRY_MAX_WORKSPACE_RUNS=10000
QUARRY_MAX_WORKSPACE_MEMBERS=100
QUARRY_MAX_EVALUATION_DAILY_TOKENS=100000
QUARRY_EVALUATION_PACE_SECONDS=60
