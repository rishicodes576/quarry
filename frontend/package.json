{
  "name": "quarry-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api.generated.ts && prettier --write src/lib/api.generated.ts",
    "format": "prettier --write src tests next.config.ts playwright.config.ts package.json",
    "format:check": "prettier --check src tests next.config.ts playwright.config.ts package.json"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
