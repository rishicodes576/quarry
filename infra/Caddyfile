{
    admin off
    servers {
        timeouts {
            read_header 5s
            read_body 15s
            idle 60s
        }
    }
    auto_https off
}
:3000 {
    request_body {
        max_size 11MiB
    }
    header -Server
    reverse_proxy web:3000 {
        header_up X-Quarry-Client-IP {remote_host}
        header_up -X-Quarry-Proxy-Secret
        flush_interval -1
    }
}
